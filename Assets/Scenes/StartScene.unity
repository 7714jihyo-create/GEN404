      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 30
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 3
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uAE30\uC0C1\uCC9C\uC678\uD55C \uD658\uC790\uC5D0\uAC8C \uCC3D\uC758\uC801\uC778
    \uC9C4\uB2E8\uC744 \uB0B4\uB824\uC8FC\uC138\uC694!\n\n1\uB2E8\uACC4\n\uCC45\uC0C1
    \uC704\uC5D0 \uB193\uC778 \uCD08\uC9C4 \uCC28\uD2B8 \uC885\uC774\uB97C \uD074\uB9AD\uD558\uC5EC\n\uD658\uC790\uC758
    \uC774\uB984, \uC99D\uC0C1 \uB4F1 \uC138\uBD80 \uC815\uBCF4\uB97C \uD655\uC778\uD569\uB2C8\uB2E4.\n\n2\uB2E8\uACC4\n\uC9C4\uB8CC\uC2E4
    \uBAA8\uB2C8\uD130\uB97C \uD074\uB9AD\uD574 \uC81C\uD55C\uC2DC\uAC04 60\uCD08
    \uB3D9\uC548\n\uCC28\uD2B8 \uB0B4\uC6A9\uC744 \uBC14\uD0D5\uC73C\uB85C \uC9C4\uB2E8\uBA85\uACFC
    \uCC98\uBC29\uC744 \uC785\uB825\uD569\uB2C8\uB2E4.\n\n3\uB2E8\uACC4\n\uC791\uC131\uD55C
    \uC9C4\uB2E8\uC11C\uB97C \uC81C\uCD9C\uD558\uBA74\n\uD658\uC790\uC758 \uCE58\uB8CC
    \uACB0\uACFC\uC640 \uD3C9\uAC00 \uC810\uC218\uB97C \uD655\uC778\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\n\n4\uB2E8\uACC4\n \uC704 \uACFC\uC815\uC744 \uBC18\uBCF5\uD574
    \uCD1D 3\uBA85\uC758 \uD658\uC790 \uC9C4\uB8CC\uB97C \uB9C8\uCE58\uBA74\n\uB77C\uC6B4\uB4DC\uAC00
    \uC885\uB8CC\uB429\uB2C8\uB2E4."
